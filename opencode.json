{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.3",
  "share": "disabled",
  "providers": {
    "zhipuai-coding-plan": {
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3[1M]",
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    },
    "minimax-cn-coding-plan": {
      "models": {
        "MiniMax-M3": { "name": "MiniMax-M3（评审备选）" }
      }
    }
  },
  "agents": {
    "method-review": {
      "description": "仅分析提供的脱敏方法；无工具权限。评审必须在不含项目原始材料的隔离目录运行。",
      "mode": "primary",
      "system": "只评审用户明确提供的文本。不得调用工具、访问文件或网络、运行命令、修改材料、启动子代理。不得分享或发布材料。中文回答，明确证据与未知。",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
